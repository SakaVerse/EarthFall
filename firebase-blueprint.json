{
  "entities": {
    "NicknameReservation": {
      "title": "Nickname Reservation",
      "description": "Unique nickname reservation locked to a player's Firebase UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "nickname": { "type": "string", "maxLength": 12, "minLength": 2, "pattern": "^[a-zA-Z0-9]+$" },
        "nicknameLower": { "type": "string", "maxLength": 12, "minLength": 2, "pattern": "^[a-zA-Z0-9]+$" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "nickname", "nicknameLower"]
    },
    "PlayerProfile": {
      "title": "Player Profile",
      "description": "Player record linking UID to active nickname, avatar, country, device signature, and career statistics in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "nickname": { "type": "string", "maxLength": 12, "minLength": 2, "pattern": "^[a-zA-Z0-9]+$" },
        "nicknameLower": { "type": "string", "maxLength": 12, "minLength": 2, "pattern": "^[a-zA-Z0-9]+$" },
        "avatar": { "type": "string", "maxLength": 32 },
        "country": { "type": "string", "maxLength": 8 },
        "deviceSignature": { "type": "string", "maxLength": 256 },
        "bestScore": { "type": "number" },
        "bestDistance": { "type": "number" },
        "bestSurvivalTime": { "type": "number" },
        "totalRuns": { "type": "number" },
        "coins": { "type": "number" },
        "scrapBalance": { "type": "number" },
        "unlockedSkins": { "type": "array" },
        "unlockedThemes": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "nickname", "nicknameLower"]
    },
    "DailyScore": {
      "title": "Daily Leaderboard Score",
      "description": "Anti-bot validated score entry for competitive leaderboard with podium, country and avatar",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "nickname": { "type": "string", "maxLength": 12, "minLength": 2, "pattern": "^[a-zA-Z0-9]+$" },
        "nicknameLower": { "type": "string", "maxLength": 12 },
        "score": { "type": "number" },
        "dateKey": { "type": "string", "maxLength": 10, "minLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "roundDuration": { "type": "number" },
        "distance": { "type": "number" },
        "zone": { "type": "string", "maxLength": 64 },
        "avatar": { "type": "string", "maxLength": 32 },
        "country": { "type": "string", "maxLength": 8 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "nickname", "score", "dateKey", "roundDuration"]
    }
  },
  "firestore": {
    "/nicknames/{nicknameLower}": {
      "schema": "NicknameReservation",
      "description": "Unique nickname reservation mapping lowercased nickname to player UID"
    },
    "/players/{uid}": {
      "schema": "PlayerProfile",
      "description": "Player profile storing registered nickname, avatar, statistics, and career progress"
    },
    "/daily_scores/{scoreId}": {
      "schema": "DailyScore",
      "description": "Daily global score entries with dateKey reset, country, avatar, and anti-bot validation"
    }
  }
}

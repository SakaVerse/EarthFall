rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives & Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isCaller(uid) {
      return (request.auth != null && request.auth.uid == uid) ||
             (request.auth == null && uid is string && uid.size() >= 3 && uid.size() <= 128);
    }

    // Validation for Nickname Reservation: /nicknames/{nicknameLower}
    function isValidNicknameReservation(data) {
      return data.keys().hasAll(['uid', 'nickname', 'nicknameLower']) &&
             data.keys().hasOnly(['uid', 'nickname', 'nicknameLower', 'createdAt']) &&
             data.uid is string && data.uid.size() >= 3 && data.uid.size() <= 128 &&
             data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 12 &&
             data.nickname.matches('^[a-zA-Z0-9]+$') &&
             data.nicknameLower is string && data.nicknameLower.size() >= 2 && data.nicknameLower.size() <= 12 &&
             data.nicknameLower.matches('^[a-z0-9]+$') &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Validation for Player Profile: /players/{uid}
    function isValidPlayerProfile(data) {
      return data.keys().hasAll(['uid', 'nickname', 'nicknameLower']) &&
             data.keys().hasOnly(['uid', 'nickname', 'nicknameLower', 'avatar', 'country', 'deviceSignature', 'bestScore', 'bestDistance', 'bestSurvivalTime', 'totalRuns', 'coins', 'scrapBalance', 'unlockedSkins', 'unlockedThemes', 'updatedAt']) &&
             data.uid is string && data.uid.size() >= 3 && data.uid.size() <= 128 &&
             data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 12 &&
             data.nickname.matches('^[a-zA-Z0-9]+$') &&
             data.nicknameLower is string && data.nicknameLower.size() >= 2 && data.nicknameLower.size() <= 12 &&
             data.nicknameLower.matches('^[a-z0-9]+$') &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 32)) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 8)) &&
             (!('deviceSignature' in data) || (data.deviceSignature is string && data.deviceSignature.size() <= 256)) &&
             (!('bestScore' in data) || (data.bestScore is number && data.bestScore >= 0)) &&
             (!('bestDistance' in data) || (data.bestDistance is number && data.bestDistance >= 0)) &&
             (!('bestSurvivalTime' in data) || (data.bestSurvivalTime is number && data.bestSurvivalTime >= 0)) &&
             (!('totalRuns' in data) || (data.totalRuns is number && data.totalRuns >= 0)) &&
             (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
             (!('scrapBalance' in data) || (data.scrapBalance is number && data.scrapBalance >= 0)) &&
             (!('unlockedSkins' in data) || (data.unlockedSkins is list && data.unlockedSkins.size() <= 30)) &&
             (!('unlockedThemes' in data) || (data.unlockedThemes is list && data.unlockedThemes.size() <= 20)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for Daily Score: /daily_scores/{scoreId}
    function isValidDailyScore(data) {
      return data.keys().hasAll(['uid', 'nickname', 'score', 'dateKey', 'roundDuration']) &&
             data.keys().hasOnly(['uid', 'nickname', 'nicknameLower', 'score', 'dateKey', 'roundDuration', 'distance', 'zone', 'avatar', 'country', 'updatedAt']) &&
             data.uid is string && data.uid.size() >= 3 && data.uid.size() <= 128 &&
             data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 12 &&
             data.nickname.matches('^[a-zA-Z0-9]+$') &&
             (!('nicknameLower' in data) || (data.nicknameLower is string && data.nicknameLower.size() <= 12)) &&
             data.score is number && data.score > 0 && data.score <= 1000000 &&
             data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.roundDuration is number && data.roundDuration >= 5 &&
             (!('distance' in data) || (data.distance is number && data.distance >= 0)) &&
             (!('zone' in data) || (data.zone is string && data.zone.size() <= 64)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 32)) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 8)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Collection 1: Nicknames (Reservation & Ownership)
    // Public read so availability can be verified instantly.
    // Create locks to the caller's UID. Update only permitted if same UID owns it.
    match /nicknames/{nicknameLower} {
      allow read: if true;
      allow create: if isValidId(nicknameLower) &&
                       isValidNicknameReservation(incoming()) &&
                       incoming().nicknameLower == nicknameLower &&
                       isCaller(incoming().uid);
      allow update: if isValidId(nicknameLower) &&
                       isValidNicknameReservation(incoming()) &&
                       existing().uid == incoming().uid &&
                       isCaller(incoming().uid);
      allow delete: if false;
    }

    // Collection 2: Players (Career Profiles & Statistics)
    // Public read so rankings and player profiles can resolve metadata.
    match /players/{uid} {
      allow read: if true;
      allow create: if isValidId(uid) &&
                       isValidPlayerProfile(incoming()) &&
                       incoming().uid == uid &&
                       isCaller(uid);
      allow update: if isValidId(uid) &&
                       isValidPlayerProfile(incoming()) &&
                       incoming().uid == uid &&
                       isCaller(uid);
      allow delete: if false;
    }

    // Collection 3: Daily Scores (Real-Time Global Competitive Leaderboard)
    // Public read for real-time rankings and filters.
    // Creates and updates require score > 0, score <= 1000000, roundDuration >= 5s.
    match /daily_scores/{scoreId} {
      allow read: if true;
      allow create: if isValidId(scoreId) &&
                       isValidDailyScore(incoming()) &&
                       isCaller(incoming().uid);
      allow update: if isValidId(scoreId) &&
                       isValidDailyScore(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().score >= existing().score &&
                       isCaller(incoming().uid);
      allow delete: if false;
    }

    // Legacy fallback compatibility for leaderboard collection during migration
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }
  }
}

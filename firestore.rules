rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Leaderboard validation
    function isValidLeaderboard(data) {
      return data.keys().hasAll(['userId', 'username', 'score', 'date']) &&
             data.keys().hasOnly(['userId', 'username', 'usernameLower', 'score', 'date', 'distance', 'zone', 'skin', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 20 &&
             data.username.matches('^[a-zA-Z0-9_]+$') &&
             (!('usernameLower' in data) || (data.usernameLower is string && data.usernameLower.size() <= 20)) &&
             data.score is number && data.score >= 0 &&
             data.date is string && data.date.size() <= 16 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('distance' in data) || (data.distance is number && data.distance >= 0)) &&
             (!('zone' in data) || (data.zone is string && data.zone.size() <= 64)) &&
             (!('skin' in data) || (data.skin is string && data.skin.size() <= 32)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User profile validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'username', 'scrapBalance']) &&
             data.keys().hasOnly(['userId', 'username', 'scrapBalance', 'bestScore', 'bestDistance', 'unlockedSkins', 'unlockedThemes', 'streak', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 20 &&
             data.username.matches('^[a-zA-Z0-9_]+$') &&
             data.scrapBalance is number && data.scrapBalance >= 0 &&
             (!('bestScore' in data) || (data.bestScore is number && data.bestScore >= 0)) &&
             (!('bestDistance' in data) || (data.bestDistance is number && data.bestDistance >= 0)) &&
             (!('unlockedSkins' in data) || (data.unlockedSkins is list && data.unlockedSkins.size() <= 30)) &&
             (!('unlockedThemes' in data) || (data.unlockedThemes is list && data.unlockedThemes.size() <= 20)) &&
             (!('streak' in data) || (data.streak is number && data.streak >= 0)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Collection: Global Daily Leaderboard
    // Public read so all players can view real global rankings for today
    // Writes restricted to authenticated players
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       isValidLeaderboard(incoming()) &&
                       incoming().userId == request.auth.uid;
      allow update: if isSignedIn() &&
                       isValidId(entryId) &&
                       isValidLeaderboard(incoming()) &&
                       (incoming().userId == existing().userId || incoming().userId == request.auth.uid);
      allow delete: if isSignedIn() &&
                       isValidId(entryId) &&
                       existing().userId == request.auth.uid;
    }

    // Collection: User Profiles & Cloud Saves
    match /users/{userId} {
      allow read: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == request.auth.uid;
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
